page { background: #16161f; }
.page-pad { padding: 14px; }
.card { background: #1e1e2c; border-radius: 14px; padding: 14px; margin-bottom: 12px; }
.title { color: #e6e6ed; font-size: 15px; font-weight: 600; margin-bottom: 10px; }
.muted { color: #8a8a9a; font-size: 12px; }
.error { color: #e94560; font-size: 13px; padding: 10px 2px; }
.platforms { display: flex; gap: 10px; flex-wrap: wrap; }
.platform { padding: 8px 18px; border-radius: 18px; background: #2a2a3a; color: #c8c8d0; font-size: 14px; }
.platform.active { background: #d4af37; color: #1a1a2e; font-weight: 600; }
.btn { background: #2a2a3a; color: #e6e6ed; font-size: 14px; border-radius: 10px; margin: 0 0 10px; }
.btn::after { border: none; }
.input { height: 42px; line-height: 42px; background: #2a2a3a; border-radius: 10px; padding: 0 12px; color: #e6e6ed; font-size: 14px; }
.primary { background: #e94560; color: #fff; font-size: 16px; font-weight: 600; border-radius: 12px; margin: 4px 0 12px; }
.primary::after { border: none; }
.preview .amount, .success .amount { color: #f0d060; font-size: 24px; font-weight: 700; margin: 8px 0; }
