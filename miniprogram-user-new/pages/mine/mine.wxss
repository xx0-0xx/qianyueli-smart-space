page { background: #16161f; }
.profile-head { display:flex; align-items:flex-start; justify-content:space-between; gap:12px; padding:4px 2px 18px; }
.profile-copy { flex:1; min-width:0; }
.profile-name { color:#eee; font-size:21px; font-weight:700; line-height:1.3; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.profile-tags { display:flex; align-items:center; gap:8px; flex-wrap:wrap; margin-top:7px; }
.profile-member { display:inline-block; padding:2px 9px; border-radius:20px; background:rgba(212,175,55,0.15); color:#d4af37; font-size:12px; font-weight:600; }
.profile-expiry { color:#8a8a9a; font-size:11px; }
.profile-edit { color:#d4af37; font-size:13px; padding:3px 0; flex-shrink:0; }
.voucher-entry { display:flex; align-items:center; justify-content:space-between; background:#1e1e2c; border-radius:14px; padding:16px; margin-bottom:16px; }
.voucher-title { color:#f0d060; font-size:15px; font-weight:600; }
.voucher-desc { color:#8a8a9a; font-size:11px; margin-top:4px; }
.voucher-arrow { color:#5a5a6a; font-size:22px; }
.account-list { margin:2px 0 18px; border-top:1px solid #2a2a3a; }
.account-row { display:flex; align-items:center; justify-content:space-between; min-height:50px; padding:0 2px; border-bottom:1px solid #2a2a3a; }
.account-label { color:#c8c8d0; font-size:14px; }
.account-value { color:#8a8a9a; font-size:13px; }
.account-link { margin:0; padding:0 12px; height:28px; line-height:28px; border-radius:14px; background:rgba(212,175,55,0.12); color:#d4af37; font-size:12px; font-weight:600; border:none; }
.account-link::after { border:none; }
.account-right { display:flex; align-items:center; gap:6px; }
.account-count { color:#5a5a6a; font-size:12px; }
.account-arrow { color:#5a5a6a; font-size:18px; line-height:1; }
.account-detail { padding:0 2px; border-bottom:1px solid #2a2a3a; }
.account-empty { color:#5a5a6a; font-size:13px; padding:14px 2px; text-align:center; }
.recharge-row { display:flex; align-items:center; justify-content:space-between; padding:11px 2px; border-bottom:1px solid #2a2a3a; }
.recharge-row:last-child { border-bottom:none; }
.recharge-amount { color:#e6e6ed; font-size:14px; font-weight:600; }
.recharge-meta { color:#777789; font-size:11px; margin-top:3px; }
.recharge-status { color:#8a8a9a; font-size:11px; font-weight:600; }
.recharge-status.is-done { color:#d4af37; }
.ledger-row { display:flex; align-items:center; justify-content:space-between; padding:13px 2px; border-bottom:1px solid #2a2a3a; }
.ledger-title { color:#e6e6ed; font-size:14px; }
.ledger-time { color:#777789; font-size:11px; margin-top:3px; }
.ledger-amount { font-size:14px; font-weight:600; }
.ledger-in { color:#d4af37; }
.ledger-out { color:#c8c8d0; }
