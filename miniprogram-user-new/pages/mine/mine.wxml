<view class="page-pad">
  <view class="profile-head">
    <view class="profile-copy">
      <view class="profile-name">{{user.nickname || user.nick_name || '未设置昵称'}}</view>
      <view wx:if="{{membership && membership.is_member}}" class="profile-tags">
        <text class="profile-member">{{membership.level_name}}</text>
        <text class="profile-expiry">{{membership.expires_text}}</text>
      </view>
    </view>
    <text class="profile-edit" bindtap="editNickname">编辑</text>
  </view>

  <!-- 余额卡片 -->
  <view style="background:#1e1e2c;border-radius:16px;display:flex;align-items:center;margin-bottom:16px;overflow:hidden">
    <view style="flex:1;padding:20px 0 20px 20px">
      <view style="font-size:12px;color:#8a8a9a;margin-bottom:8px">账户余额（当前门店 · 元）</view>
      <view style="font-size:26px;font-weight:bold;color:#f0d060">{{balanceYuan}}</view>
      <view style="font-size:11px;color:#5a5a6a;margin-top:6px">本余额在本门店所属共享组内通用</view>
    </view>
    <view bindtap="goRecharge" style="width:80px;height:40px;line-height:40px;text-align:center;background:linear-gradient(135deg,#f0d060,#d4af37);color:#1a1a2e;font-size:14px;font-weight:bold;margin-right:20px;border-radius:8px">充 值</view>
  </view>

  <view class="voucher-entry" bindtap="goVoucherRecharge">
    <view>
      <view class="voucher-title">团购券充值</view>
      <view class="voucher-desc">美团/抖音团购券自助充余额</view>
    </view>
    <text class="voucher-arrow">›</text>
  </view>

  <view class="account-list">
    <view class="account-row">
      <text class="account-label">手机号</text>
      <text wx:if="{{user.phone}}" class="account-value">{{displayPhone}}</text>
      <button
        wx:else
        open-type="getPhoneNumber"
        bindgetphonenumber="onGetPhoneNumber"
        class="account-link"
      >
        去绑定
      </button>
    </view>
    <view class="account-row" bindtap="toggleBalanceLogs">
      <text class="account-label">余额明细</text>
      <view class="account-right">
        <text class="account-count">{{balanceLogs.length ? balanceLogs.length + ' 条' : '暂无'}}</text>
        <text class="account-arrow">{{showBalanceLogs ? '⌃' : '›'}}</text>
      </view>
    </view>
    <view wx:if="{{showBalanceLogs}}" class="account-detail">
      <block wx:for="{{balanceLogs}}" wx:key="id">
        <view class="ledger-row">
          <view>
            <view class="ledger-title">{{item.desc || (item.type==='order'?'预约消费':item.type==='refund'?'退款':'余额变动')}}</view>
            <view class="ledger-time">{{item.timeText}}</view>
          </view>
          <text class="ledger-amount {{item.amount>=0?'ledger-in':'ledger-out'}}">{{item.amount>=0?'+':''}}{{item.amountYuan}}</text>
        </view>
      </block>
      <view wx:if="{{!loading && balanceLogs.length===0}}" class="account-empty">暂无余额明细</view>
    </view>

    <view class="account-row" bindtap="toggleRecharges">
      <text class="account-label">充值记录</text>
      <view class="account-right">
        <text class="account-count">{{recharges.length ? recharges.length + ' 条' : '暂无'}}</text>
        <text class="account-arrow">{{showRecharges ? '⌃' : '›'}}</text>
      </view>
    </view>
    <view wx:if="{{showRecharges}}" class="account-detail">
      <block wx:for="{{recharges}}" wx:key="id">
        <view class="recharge-row">
          <view>
            <view class="recharge-amount">¥{{item.amountYuan}}</view>
            <view class="recharge-meta">{{item.timeText}}</view>
          </view>
          <text class="recharge-status {{item.status===1?'is-done':''}}">{{item.status===0?'待确认':item.status===1?'已到账':'已取消'}}</text>
        </view>
      </block>
      <view wx:if="{{recharges.length===0}}" class="account-empty">暂无充值记录</view>
    </view>

    <view class="account-row" bindtap="openAgreement">
      <text class="account-label">用户服务协议</text>
      <text class="account-arrow">›</text>
    </view>
    <view class="account-row" bindtap="openPrivacy">
      <text class="account-label">隐私政策</text>
      <text class="account-arrow">›</text>
    </view>
  </view>

  <view wx:if="{{needStore}}" class="state-message">请先在首页选择门店，以查看该门店的余额</view>
  <view wx:if="{{error}}" class="state-message state-error">{{error}}</view>
</view>
