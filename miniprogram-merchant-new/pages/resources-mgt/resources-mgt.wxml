<view class="page-pad">
  <view style="display:flex;align-items:center;gap:8px;margin-bottom:16px">
    <view bindtap="goBack" style="width:32px;height:32px;border-radius:16px;background:#e3f2fd;display:flex;align-items:center;justify-content:center;font-size:14px;color:#022A99">←</view>
    <view class="section-title" style="margin-bottom:0">房间管理</view>
  </view>
  <block wx:for="{{types}}" wx:key="id">
    <view class="card">
      <view style="font-size:15px;font-weight:bold;color:#022A99;margin-bottom:10px">{{item.name}}</view>
      <block wx:for="{{item.rooms}}" wx:key="id" wx:for-item="room">
        <view style="display:flex;justify-content:space-between;align-items:center;padding:10px 0;border-top:1px solid #f0f0f0">
          <text style="font-size:14px;color:#333;line-height:32px;flex:1">{{room.name}}</text>
          <button class="btn-sm" style="background:#e3f2fd;color:#022A99;width:56px;text-align:center;flex-shrink:0" bindtap="bindDevice" data-rid="{{room.id}}">绑定</button>
          <button class="btn-sm" style="background:#f5f5f5;color:#666;width:56px;text-align:center;flex-shrink:0;margin-left:4px" bindtap="delRoom" data-id="{{room.id}}">删除</button>
        </view>
      </block>
      <view wx:if="{{item.rooms.length===0}}" style="font-size:12px;color:#bbb;margin:8px 0">暂未添加房间</view>
      <view style="display:flex;align-items:center;gap:8px;margin-top:10px;padding-top:10px;border-top:1px solid #f0f0f0">
        <input class="input" value="{{item._input}}" bindinput="onRoomInput" data-tid="{{item.id}}" placeholder="新房间名称" style="flex:1;margin-bottom:0"/>
        <button class="btn-sm btn-blue" style="flex-shrink:0;width:56px;text-align:center" bindtap="addRoom" data-tid="{{item.id}}">添加</button>
      </view>
    </view>
  </block>
  <view wx:if="{{types.length===0}}" class="empty">请先在管理页添加房型</view>
</view>