<view class="page-pad">
  <view style="display:flex;align-items:center;gap:8px;margin-bottom:12px">
    <view bindtap="goBack" style="width:32px;height:32px;border-radius:16px;background:#e3f2fd;display:flex;align-items:center;justify-content:center;font-size:14px;color:#022A99">←</view>
    <view class="section-title" style="margin-bottom:0">定价管理</view>
  </view>

  <view class="card" style="margin-bottom:12px">
    <view style="font-size:14px;font-weight:bold;color:#333;margin-bottom:8px">按房型设置价格（该房型下所有房间统一）</view>
    <view wx:for="{{typePrices}}" wx:key="type_id" style="display:flex;align-items:center;gap:8px;margin-bottom:8px;padding-bottom:8px;border-bottom:1px solid #f0f0f0">
      <text style="font-size:13px;color:#333;width:70px">{{item.name}}</text>
      <input class="input" type="number" value="{{item.price}}" bindinput="onTypeInput" data-id="{{item.type_id}}" style="flex:1;height:36px"/>
      <text style="font-size:12px;color:#999">元/小时</text>
    </view>
  </view>

  <button class="btn-primary" bindtap="save">保存定价</button>
</view>
