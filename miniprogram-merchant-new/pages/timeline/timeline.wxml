<view class="page-pad">
  <view style="display:flex;align-items:center;gap:8px;margin-bottom:12px">
    <view bindtap="goBack" style="width:32px;height:32px;border-radius:16px;background:#e3f2fd;display:flex;align-items:center;justify-content:center;font-size:14px;color:#022A99">←</view>
    <view class="section-title" style="margin-bottom:0">房间时段</view>
  </view>
  <view style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px">
    <view bindtap="prevDay" style="font-size:22px;color:#022A99;padding:4px 8px">‹</view>
    <view style="font-size:16px;font-weight:bold;color:#333">{{date}}</view>
    <view bindtap="nextDay" style="font-size:22px;color:#022A99;padding:4px 8px">›</view>
  </view>
  <view style="background:#fff;border-radius:12px;overflow:hidden">
    <scroll-view scroll-x style="width:100%">
      <view style="min-width:750px">
        <view style="display:flex;border-bottom:1px solid #f0f0f0">
          <view style="width:70px;flex-shrink:0;padding:8px 4px;font-size:12px;color:#999">房间</view>
          <view wx:for="{{hours}}" wx:key="index" style="width:28px;flex-shrink:0;padding:4px 0;font-size:10px;color:#999;text-align:center">{{item}}</view>
        </view>
        <view wx:for="{{rows}}" wx:key="id" style="display:flex;border-bottom:1px solid #f5f5f5">
          <view style="width:70px;flex-shrink:0;padding:6px 4px;font-size:11px;color:#333;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{{item.name}}</view>
          <view wx:for="{{item.cells}}" wx:key="index" wx:for-item="c" style="width:28px;flex-shrink:0;height:24px;background:{{c===1?'#022A99':'#fafafa'}};border-right:1px solid #f0f0f0"></view>
        </view>
      </view>
    </scroll-view>
  </view>
  <view style="display:flex;gap:16px;margin-top:12px;font-size:11px;color:#999">
    <view style="display:flex;align-items:center;gap:4px"><view style="width:12px;height:12px;background:#022A99;border-radius:2px"></view>已预约</view>
    <view style="display:flex;align-items:center;gap:4px"><view style="width:12px;height:12px;background:#fafafa;border-radius:2px;border:1px solid #f0f0f0"></view>空闲</view>
  </view>
</view>
