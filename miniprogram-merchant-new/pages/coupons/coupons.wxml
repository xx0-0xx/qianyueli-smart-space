<view class="page-pad">
  <view style="display:flex;align-items:center;gap:8px;margin-bottom:12px">
    <view bindtap="goBack" style="width:32px;height:32px;border-radius:16px;background:#e3f2fd;display:flex;align-items:center;justify-content:center;font-size:14px;color:#022A99">←</view>
    <view class="section-title" style="margin-bottom:0;flex:1">券码管理</view>
    <button wx:if="{{tab==='unused'&&unusedCount>0}}" class="btn-sm" style="background:#022A99;color:#fff" bindtap="exportCodes">导出</button>
  </view>

  <!-- 生成区 -->
  <view class="card" style="margin-bottom:12px">
    <view style="font-size:14px;font-weight:bold;color:#333;margin-bottom:8px">生成券码</view>
    <view style="font-size:11px;color:#999;margin-bottom:10px">顾客在小程序「券码兑换」输入券码，金额直接充入余额</view>
    <input class="input" value="{{couponName}}" bindinput="onNameIn" placeholder="券名（如 新人礼包）" style="margin-bottom:8px"/>
    <view style="display:flex;gap:8px;margin-bottom:8px">
      <input class="input" type="digit" value="{{discount}}" bindinput="onDiscountIn" placeholder="面额（元）" style="flex:1"/>
      <input class="input" type="number" value="{{count}}" bindinput="onCountIn" placeholder="数量" style="width:90px"/>
    </view>
    <button class="btn-sm btn-blue" bindtap="create">生成券码</button>
  </view>

  <!-- 分组 tab -->
  <view style="display:flex;gap:20px;margin-bottom:12px;padding:0 4px">
    <view bindtap="switchTab" data-tab="unused" style="font-size:15px;font-weight:bold;color:{{tab==='unused'?'#022A99':'#999'}}">未使用 ({{unusedCount}})</view>
    <view bindtap="switchTab" data-tab="used" style="font-size:15px;font-weight:bold;color:{{tab==='used'?'#022A99':'#999'}}">已使用 ({{usedCount}})</view>
  </view>

  <!-- 未使用 -->
  <block wx:if="{{tab==='unused'}}">
    <view class="card" wx:if="{{unusedList.length>0}}">
      <view wx:for="{{unusedList}}" wx:key="id" style="padding:10px 0;border-bottom:1px solid #f0f0f0">
        <view style="display:flex;justify-content:space-between;align-items:center">
          <view style="flex:1" bindtap="copyCode" data-code="{{item.code}}">
            <text style="font-size:15px;color:#022A99;font-weight:bold;font-family:monospace">{{item.code}}</text>
            <text style="font-size:11px;color:#999;margin-left:8px">{{item.name}} ¥{{item._amount}}</text>
          </view>
          <text style="font-size:12px;color:#4caf50;margin-right:6px">未用</text>
        </view>
        <view style="display:flex;gap:8px;margin-top:8px">
          <button class="btn-sm" style="background:#e3f2fd;color:#022A99;flex:1" bindtap="copyCode" data-code="{{item.code}}">复制</button>
          <button class="btn-sm" style="background:#fce4ec;color:#e94560;flex:1" bindtap="delCoupon" data-id="{{item.id}}">删除</button>
        </view>
      </view>
    </view>
    <view wx:if="{{unusedList.length===0}}" class="empty">暂无未使用券码</view>
  </block>

  <!-- 已使用（归档） -->
  <block wx:if="{{tab==='used'}}">
    <view class="card" wx:if="{{usedList.length>0}}">
      <view wx:for="{{usedList}}" wx:key="id" style="display:flex;justify-content:space-between;align-items:center;padding:10px 0;border-bottom:1px solid #f0f0f0">
        <view style="flex:1">
          <text style="font-size:14px;color:#bbb;font-weight:bold;font-family:monospace">{{item.code}}</text>
          <text style="font-size:11px;color:#bbb;margin-left:8px">{{item.name}} ¥{{item._amount}}</text>
        </view>
        <text style="font-size:12px;color:#999;margin-right:6px">已用</text>
        <button class="btn-sm" style="background:#f5f5f5;color:#999" bindtap="delCoupon" data-id="{{item.id}}">删除</button>
      </view>
    </view>
    <view wx:if="{{usedList.length===0}}" class="empty">暂无已使用券码</view>
  </block>
</view>
