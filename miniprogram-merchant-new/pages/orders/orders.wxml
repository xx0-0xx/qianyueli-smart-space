<view class="page-pad">
  <view style="display:flex;gap:12px;margin-bottom:16px">
    <view bindtap="switchTab" data-tab="orders" style="font-size:16px;font-weight:bold;color:{{tab==='orders'?'#022A99':'#999'}}">订单</view>
    <view bindtap="switchTab" data-tab="refunds" style="font-size:16px;font-weight:bold;color:{{tab==='refunds'?'#022A99':'#999'}}">退款审批<text wx:if="{{refundCount>0}}" style="background:#e94560;color:#fff;border-radius:10px;padding:0 6px;font-size:11px;margin-left:4px">{{refundCount}}</text></view>
  </view>

  <block wx:if="{{tab==='orders'}}">
    <block wx:for="{{orders}}" wx:key="id">
      <view class="card" bindtap="showDetail" data-id="{{item.id}}" data-index="{{index}}">
        <view style="display:flex;justify-content:space-between;align-items:center;margin-bottom:4px">
          <view class="tag {{item.status===1||item.status===2?'tag-on':item.status===0||item.status===3?'tag-off':'tag-warn'}}">{{item.status===0?'待支付':item.status===1?'已支付':item.status===2?'进行中':item.status===3?'已完成':item.status===4?'已取消':item.status===5?'退款中':'已退款'}}</view>
          <text style="font-size:12px;color:#bbb">#{{item.order_no}}</text>
        </view>
        <view style="font-size:15px;font-weight:bold;color:#333;margin-bottom:2px">{{item.resource_name||'房间'}}</view>
        <view style="font-size:12px;color:#999;margin-bottom:6px">{{item.timeText}}</view>
        <view style="display:flex;justify-content:space-between;align-items:center">
          <text style="color:#022A99;font-weight:bold;background:#e3f2fd;padding:2px 8px;border-radius:8px;font-size:13px">{{item.price}}元</text>
          <view style="display:flex;gap:8px">
            <button wx:if="{{item.status===0}}" class="btn-sm" style="background:#f5f5f5;color:#666" catchtap="cancelOrder" data-id="{{item.id}}">取消</button>
            <button wx:if="{{item.status===1||item.status===2}}" class="btn-sm" style="background:#e94560;color:#fff" catchtap="refundOrder" data-id="{{item.id}}">退款</button>
          </view>
        </view>
      </view>
    </block>
    <view wx:if="{{orders.length===0&&!loading}}" class="empty">暂无订单</view>
    <view wx:if="{{page<totalPages}}" bindtap="loadMore" style="text-align:center;padding:14px;color:#022A99;font-size:13px">{{loading?'加载中…':'加载更多'}}</view>
    <view wx:if="{{page>=totalPages&&orders.length>0}}" style="text-align:center;padding:10px;color:#bbb;font-size:12px">已加载全部订单</view>
  </block>

  <block wx:if="{{tab==='refunds'}}">
    <block wx:for="{{refunds}}" wx:key="id">
      <view class="card">
        <view style="font-size:13px;color:#333;margin-bottom:4px">订单 #{{item.order_no||item.order_id}}</view>
        <view style="font-size:12px;color:#999;margin-bottom:4px">{{item.reason||'无理由'}}</view>
        <view style="display:flex;justify-content:space-between;align-items:center">
          <text style="color:#e94560;font-weight:bold;font-size:14px">¥{{item.amountYuan}}</text>
          <view style="display:flex;gap:8px">
            <button wx:if="{{item.status===0}}" class="btn-sm" style="background:#4caf50;color:#fff" bindtap="approve" data-id="{{item.id}}">同意</button>
            <button wx:if="{{item.status===0}}" class="btn-sm" style="background:#e94560;color:#fff" bindtap="reject" data-id="{{item.id}}">拒绝</button>
            <text wx:if="{{item.status===1}}" style="color:#4caf50;font-size:12px">已退回余额</text>
            <text wx:if="{{item.status===2}}" style="color:#999;font-size:12px">已拒绝</text>
          </view>
        </view>
      </view>
    </block>
    <view wx:if="{{refunds.length===0}}" class="empty">暂无退款申请</view>
    <view class="refund-note">同意退款仅适用于已确认的余额支付，退款金额将退回用户余额。</view>
  </block>

  <!-- 订单详情弹窗 -->
  <view wx:if="{{showDetail}}" style="position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.45);display:flex;align-items:flex-end;justify-content:center;z-index:999" bindtap="hideDetail">
    <view style="background:#fff;border-radius:20px 20px 0 0;padding:24px;width:100%;max-width:420px" catchtap="">
      <view style="font-size:17px;font-weight:bold;color:#333;margin-bottom:16px;text-align:center">订单详情</view>
      <view wx:for="{{detailRows}}" wx:key="label" style="display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid #f5f5f5">
        <text style="color:#999;font-size:14px">{{item.label}}</text>
        <text style="color:#333;font-size:14px;text-align:right">{{item.value}}</text>
      </view>
      <button class="btn-sm" style="background:#f5f5f5;color:#666;margin-top:16px" bindtap="hideDetail">关闭</button>
    </view>
  </view>
</view>
