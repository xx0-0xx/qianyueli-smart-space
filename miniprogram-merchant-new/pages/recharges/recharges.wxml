<view class="page-pad">
  <view style="display:flex;align-items:center;gap:8px;margin-bottom:16px">
    <view bindtap="goBack" style="width:32px;height:32px;border-radius:16px;background:#e3f2fd;display:flex;align-items:center;justify-content:center;font-size:14px;color:#022A99">←</view>
    <view class="section-title" style="margin-bottom:0;flex:1">充值确认</view>
    <view bindtap="switchTab" data-tab="0" style="font-size:13px;color:{{tab==='0'?'#022A99':'#999'}};font-weight:{{tab==='0'?'bold':'normal'}}">待确认</view>
    <view bindtap="switchTab" data-tab="1" style="font-size:13px;color:{{tab==='1'?'#022A99':'#999'}};font-weight:{{tab==='1'?'bold':'normal'}}">已到账</view>
  </view>

  <block wx:for="{{list}}" wx:key="id">
    <view class="card">
      <view style="display:flex;justify-content:space-between;align-items:center;margin-bottom:4px">
        <text style="font-size:15px;font-weight:bold;color:#022A99">¥{{item.amountYuan}}</text>
        <view class="tag {{item.status===0?'tag-warn':'tag-on'}}">{{item.status===0?'待确认':'已到账'}}</view>
      </view>
      <view style="font-size:12px;color:#999;margin-bottom:4px">用户: {{item.nickname||'用户'}} · {{item.timeText}}</view>
      <view wx:if="{{item.note}}" style="font-size:12px;color:#bbb;margin-bottom:4px">备注: {{item.note}}</view>
      <view style="font-size:11px;color:#ccc">单号 #{{item.id}}</view>
      <view wx:if="{{item.status===0}}" style="display:flex;gap:8px;margin-top:10px">
        <button class="btn-sm" style="background:#4caf50;color:#fff;flex:1" bindtap="confirm" data-id="{{item.id}}">确认到账</button>
        <button class="btn-sm" style="background:#f5f5f5;color:#666;flex:1" bindtap="cancel" data-id="{{item.id}}">取消</button>
      </view>
    </view>
  </block>
  <view wx:if="{{list.length===0}}" class="empty">暂无记录</view>
</view>
