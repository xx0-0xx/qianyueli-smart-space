<view class="page-pad">
  <view style="display:flex;align-items:center;gap:8px;margin-bottom:16px">
    <view bindtap="goBack" style="width:32px;height:32px;border-radius:16px;background:#e3f2fd;display:flex;align-items:center;justify-content:center;font-size:14px;color:#022A99">←</view>
    <view class="section-title" style="margin-bottom:0">月度报表</view>
  </view>
    <block wx:for="{{months}}" wx:key="month">
    <view class="card" bindtap="showDetail" data-month="{{item.month}}">
      <view style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px">
        <view style="font-size:16px;font-weight:bold;color:#022A99">{{item.month}}</view>
        <view style="font-size:20px;font-weight:bold;color:#333">{{item.revenue}}<text style="font-size:12px;color:#999;font-weight:normal"> 元</text></view>
      </view>
      <view style="display:flex;gap:16px;font-size:12px;color:#666">
        <text>总订单 {{item.total}}</text>
        <text>已支付 {{item.paid}}</text>
        <text>已退款 {{item.refund}}</text>
        <text>客单价 {{item.avgPrice}}元</text>
      </view>
    </view>
  </block>
  <view wx:if="{{months.length===0}}" class="empty">暂无数据</view>
</view>