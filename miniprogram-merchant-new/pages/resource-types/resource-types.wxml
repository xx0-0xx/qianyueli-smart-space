<view class="page-pad">
  <view style="display:flex;align-items:center;gap:8px;margin-bottom:16px">
    <view bindtap="goDashboard" style="width:32px;height:32px;border-radius:16px;background:#e3f2fd;display:flex;align-items:center;justify-content:center;font-size:14px;color:#022A99">←</view>
    <view class="section-title" style="margin-bottom:0">管理</view>
  </view>
  <view class="card" bindtap="goResources">
    <view class="row"><view><view style="font-size:16px;font-weight:bold;color:#333">房间管理</view><view style="font-size:12px;color:#bbb">管理房间和绑定设备</view></view><view style="color:#bbb">></view></view>
  </view>
  <view class="card" bindtap="goTypeMgt">
    <view class="row"><view><view style="font-size:16px;font-weight:bold;color:#333">房型管理</view><view style="font-size:12px;color:#bbb">添加和删除房型</view></view><view style="color:#bbb">></view></view>
  </view>
  <view class="card" bindtap="goPricing">
    <view class="row"><view><view style="font-size:16px;font-weight:bold;color:#333">定价管理</view><view style="font-size:12px;color:#bbb">设置每小时定价</view></view><view style="color:#bbb">></view></view>
  </view>
  <view class="card" bindtap="goCoupons">
    <view class="row"><view><view style="font-size:16px;font-weight:bold;color:#333">团购券管理</view><view style="font-size:12px;color:#bbb">生成和管理团购券</view></view><view style="color:#bbb">></view></view>
  </view>
  <view class="card" bindtap="goStoreConfig">
    <view class="row"><view><view style="font-size:16px;font-weight:bold;color:#333">门店设置</view><view style="font-size:12px;color:#bbb">WiFi、电话、封面图</view></view><view style="color:#bbb">></view></view>
  </view>
  <view class="card" bindtap="goDevices">
    <view class="row"><view><view style="font-size:16px;font-weight:bold;color:#333">设备管理</view><view style="font-size:12px;color:#bbb">查看和控制所有设备</view></view><view style="color:#bbb">></view></view>
  </view>
  <view class="card" bindtap="goVoiceConfig">
    <view class="row"><view><view style="font-size:16px;font-weight:bold;color:#333">语音播报</view><view style="font-size:12px;color:#bbb">配置成品控制器预置语音码</view></view><view style="color:#bbb">></view></view>
  </view>
  <view class="card" bindtap="offlineCtrl">
    <view class="row"><view><view style="font-size:16px;font-weight:bold;color:#333">设备配网及离线控制</view><view style="font-size:12px;color:#bbb">复制链接，浏览器打开配网和控制</view></view><view style="color:#bbb">></view></view>
  </view>
</view>
