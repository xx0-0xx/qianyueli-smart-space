.member-head{display:flex;align-items:center;gap:8px;margin-bottom:16px}
.member-back{width:32px;height:32px;border-radius:16px;background:#e3f2fd;display:flex;align-items:center;justify-content:center;font-size:14px;color:#022A99}
.member-title{margin-bottom:0}
.member-note{margin-top:10px;font-size:11px;color:#999;line-height:1.6}
.member-search-row{display:flex;gap:8px;align-items:center}
.member-search{flex:1;height:40px}
.member-search-btn{flex-shrink:0;width:64px;text-align:center}
.member-empty-card{padding:28px 18px}
.member-empty{margin-top:0}
.member-empty-btn{margin-top:16px;width:120px}
.member-loading{margin-top:40px}
.member-error-card{text-align:center}
.member-error{font-size:13px;color:#e94560;margin-bottom:12px;word-break:break-all}
.member-retry{width:110px}
.member-card{padding:16px}
.member-top{display:flex;justify-content:space-between;align-items:center;gap:8px}
.member-name-wrap{display:flex;align-items:center;gap:8px;min-width:0}
.member-name{font-size:15px;font-weight:bold;color:#252a31;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.member-uid{font-size:11px;color:#bbb;flex-shrink:0}
.member-phone{margin-top:5px;font-size:12px;color:#7c848d}
.member-stats{display:flex;gap:24px;margin-top:12px;padding:10px 12px;background:#f7f8fa;border-radius:10px}
.member-stat{display:flex;flex-direction:column;gap:2px}
.member-stat-value{font-size:15px;font-weight:bold;color:#173f35}
.member-stat-label{font-size:11px;color:#8a929b}
.member-current{margin-top:10px;padding:10px 12px;background:#eef5f2;border-radius:10px;display:flex;flex-wrap:wrap;align-items:center;gap:8px}
.member-current-level{font-size:13px;font-weight:bold;color:#245d4d}
.member-current-expiry{font-size:11px;color:#5c7c70}
.member-remark{flex-basis:100%;font-size:11px;color:#8a929b;word-break:break-all}
.member-actions{display:flex;gap:8px;margin-top:12px}
.member-action{flex:1;text-align:center}
.member-remove{background:#fcecec;color:#c9524b}
.member-remove[disabled]{opacity:.6}
.member-level-off{font-weight:normal}
.member-footer{padding:10px 0 24px;text-align:center}
.member-foot-text{font-size:12px;color:#a0a7ae}
.member-more{padding:10px;font-size:13px;color:#022A99}
.member-more:active{opacity:.7}
.sheet-mask{position:fixed;z-index:999;top:0;right:0;bottom:0;left:0;display:flex;align-items:flex-end;justify-content:center;background:rgba(19,26,31,.42)}
.member-sheet{width:100%;max-width:480px;max-height:82vh;box-sizing:border-box;padding:18px 18px calc(18px + env(safe-area-inset-bottom));background:#fff;border-radius:12px 12px 0 0;overflow-y:auto}
.sheet-title{text-align:center;font-size:16px;font-weight:bold;color:#252a31}
.sheet-sub{margin-top:5px;text-align:center;font-size:12px;color:#8a929b}
.sheet-label{margin:16px 0 8px;font-size:12px;font-weight:bold;color:#4a535c}
.level-list{max-height:34vh;border:1px solid #e8ebef;border-radius:10px;overflow:hidden}
.level-option{display:flex;justify-content:space-between;align-items:center;padding:12px 14px;border-bottom:1px solid #eef0f2;font-size:13px;color:#3e464e}
.level-option:last-child{border-bottom:0}
.level-selected{background:#eaf2ef;color:#245d4d;font-weight:bold}
.level-discount{font-size:11px;color:#8a929b}
.level-selected .level-discount{color:#28785e}
.sheet-empty{padding:18px;text-align:center;font-size:12px;color:#a0a7ae}
.sheet-retry{margin-top:10px;width:96px;text-align:center}
.date-row{display:flex;gap:8px;align-items:center}
.date-row picker{flex:1}
.date-value{height:42px;line-height:42px;padding:0 12px;background:#f6f7f8;border-radius:8px;font-size:13px;color:#333}
.date-placeholder{color:#a0a7ae}
.date-clear{flex-shrink:0;padding:0 8px;font-size:12px;color:#c9524b}
.sheet-remark{width:100%;height:72px;box-sizing:border-box;padding:10px 12px;background:#f6f7f8;border-radius:8px;font-size:13px;color:#333}
.sheet-actions{display:flex;align-items:center;gap:10px;margin-top:18px}
.sheet-save{flex:1;height:44px;line-height:44px;font-size:15px}
.sheet-save[disabled]{background:#b9c3d8;color:#fff}
.sheet-cancel{flex-shrink:0;width:72px;text-align:center;background:#f1f3f4;color:#59626a;height:44px;line-height:44px}
